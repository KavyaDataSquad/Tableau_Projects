      <column caption='% Total Terminated' datatype='real' default-format='p0%' name='[% Total Hired (copy)_1251437771690131456]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3363625995832086533] / TOTAL([Calculation_3363625995832086533])'>

    <worksheet name='Age vs Education'>
      <table>
        <view>
          <datasources>
            <datasource caption='HumanResources' name='federated.1uy6vyf0tya8w3119f4041qdymfc' />
          </datasources>
          <datasource-dependencies datasource='federated.1uy6vyf0tya8w3119f4041qdymfc'>
            <column datatype='date' name='[Birthdate]' role='dimension' type='ordinal' />
            <column caption='% Total Hired' datatype='real' default-format='p0%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3363625995831468034] / TOTAL([Calculation_3363625995831468034])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Status' datatype='string' name='[Calculation_2981664453132697602]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Termdate]) THEN &apos;Hired&apos;&#13;&#10;ELSE &apos;Terminated&apos;&#13;&#10;END' />
            </column>
            <column caption='Highlight Max' datatype='boolean' name='[Calculation_2981664453136855046]' role='measure' type='nominal'>
              <calculation class='tableau' formula='WINDOW_MAX([Calculation_3363625995831468034]) = [Calculation_3363625995831468034]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Total Hired' datatype='integer' name='[Calculation_3363625995831468034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([Employee_ID])' />
            </column>
            <column caption='Location' datatype='string' name='[Calculation_3363625995846344715]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [State]&#13;&#10;    WHEN &apos;New York&apos; THEN &apos;HQ&apos;&#13;&#10;    ELSE &apos;Branch&apos;&#13;&#10;END' />
            </column>
            <column caption='Age' datatype='integer' name='[Calculation_3363625995860541454]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;, [Birthdate], TODAY())' />
            </column>
            <column caption='Age Groups' datatype='string' name='[Calculation_3363625995862552598]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_3363625995860541454] &lt; 25 THEN &apos;&lt;25&apos;&#13;&#10;ELSEIF [Calculation_3363625995860541454] &gt;=25 AND [Calculation_3363625995860541454] &lt; 35 THEN &apos;25-34&apos;&#13;&#10;ELSEIF [Calculation_3363625995860541454] &gt;=35 AND [Calculation_3363625995860541454] &lt; 45 THEN &apos;35-44&apos;&#13;&#10;ELSEIF [Calculation_3363625995860541454] &gt;=45 AND [Calculation_3363625995860541454] &lt; 55 THEN &apos;45-54&apos;&#13;&#10;ELSEIF [Calculation_3363625995860541454] &gt;=55 THEN &apos;55+&apos;&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Department]' role='dimension' type='nominal' />
            <column datatype='string' name='[Education Level]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;High School&quot;' value='H-Sch' />
              </aliases>
            </column>
            <column caption='Employee ID' datatype='string' name='[Employee_ID]' role='dimension' type='nominal' />
            <column datatype='string' name='[Gender]' role='dimension' type='nominal' />
            <column datatype='date' name='[Hiredate]' role='dimension' type='ordinal' />
            <column datatype='string' name='[State]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column datatype='date' name='[Termdate]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_2981664453132697602]' derivation='None' name='[none:Calculation_2981664453132697602:nk]' pivot='key' type='nominal' />

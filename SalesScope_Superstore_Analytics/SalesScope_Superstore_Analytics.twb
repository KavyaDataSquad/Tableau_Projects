      <column caption='Average profit' datatype='real' name='[Average Sales (copy)_1241304700125630468]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{AVG(if YEAR([Order Date])=2022 THEN [Profit] END)}' />
      </column>
      <column caption='Average profit State wise' datatype='real' name='[Average Sales State wise (copy)_1241304700128747527]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [State/Province]: AVG([Total CY Sales (copy)_756886264851349507])}' />
      </column>
      <column caption='CY profit ratio' datatype='real' name='[Calculation_1241304700122140672]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total CY Sales (copy)_756886264851349507])/SUM([Calculation_756886264846561280])' />
      </column>
      <column caption='Average Sales' datatype='real' name='[Calculation_1241304700123779073]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{AVG(if YEAR([Order Date])=2022 THEN [Sales] END)}' />
      </column>
      <column caption='Color Avg Sales' datatype='string' name='[Calculation_1241304700124467202]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1241304700127969286]&lt;[Calculation_1241304700123779073] THEN &apos;Below Average&apos;&#13;&#10;ELSEIF [Calculation_1241304700127969286]&gt;[Calculation_1241304700123779073] THEN &apos;Above Average&apos;&#13;&#10;ELSEIF [Calculation_1241304700127969286]=[Calculation_1241304700123779073] THEN &apos;Equal to Average&apos;&#13;&#10;END' />
      </column>
      <column caption='Color Average profit' datatype='string' name='[Calculation_1241304700125331459]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Average Sales State wise (copy)_1241304700128747527]&lt;[Average Sales (copy)_1241304700125630468] THEN &apos;Below Average&apos;&#13;&#10;ELSEIF [Average Sales State wise (copy)_1241304700128747527]&gt;[Average Sales (copy)_1241304700125630468] THEN &apos;Above Average&apos;&#13;&#10;ELSEIF [Average Sales State wise (copy)_1241304700128747527]=[Average Sales (copy)_1241304700125630468] THEN &apos;Equal to Average&apos;&#13;&#10;END' />
      </column>
      <column caption='Average Sales State wise' datatype='real' name='[Calculation_1241304700127969286]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [State/Province]: AVG([Calculation_756886264846561280])}' />
      </column>
      <column caption='YOY Sales' datatype='real' name='[Calculation_1241304700270092296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_756886264846561280])-SUM([Calculation_756886264847196161]))/SUM([Calculation_756886264847196161])' />
      </column>
      <column caption='Profit Ratio' datatype='real' name='[Calculation_1368249927221915648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/SUM([Sales])' />
      </column>
      <column caption='YOY Sales Symbol' datatype='string' name='[Calculation_1402589862223978498]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1241304700270092296]&gt;0 THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
      </column>
      <column caption='Dynamic Measure' datatype='real' name='[Calculation_425308743390826498]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &apos;Total CY Sales&apos; THEN [Calculation_756886264846561280]&#13;&#10;WHEN &apos;Total CY Profit&apos; THEN [Total CY Sales (copy)_756886264851349507]&#13;&#10;WHEN &apos;Total CY Qty&apos; THEN [Total PY sales (copy)_772930338650066946]&#13;&#10;END' />
      </column>
      <column caption='Total CY Sales' datatype='real' name='[Calculation_756886264846561280]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Order Date])= {MAX(year([Order Date]))} THEN [Sales] END' />
      </column>
      <column caption='Total PY sales' datatype='real' name='[Calculation_756886264847196161]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Order Date])={MAX(YEAR([Order Date]))}-1&#13;&#10;&#13;&#10; THEN [Sales] END' />
      </column>
      <column caption='min max cy sales' datatype='real' name='[Calculation_756886264848355330]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Calculation_756886264846561280]) = WINDOW_MAX(SUM([Calculation_756886264846561280])) &#13;&#10;THEN SUM([Calculation_756886264846561280])&#13;&#10;ELSEIF SUM([Calculation_756886264846561280]) = WINDOW_MIN(SUM([Calculation_756886264846561280])) &#13;&#10;THEN SUM([Calculation_756886264846561280])&#13;&#10;ELSE NULL END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='min max segment' datatype='string' name='[Calculation_772930338652028932]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Calculation_756886264846561280]) = WINDOW_MAX(SUM([Calculation_756886264846561280])) &#13;&#10;THEN &apos;max&apos;&#13;&#10;ELSEIF SUM([Calculation_756886264846561280]) = WINDOW_MIN(SUM([Calculation_756886264846561280])) &#13;&#10;THEN &apos;min&apos;&#13;&#10;ELSE NULL END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>

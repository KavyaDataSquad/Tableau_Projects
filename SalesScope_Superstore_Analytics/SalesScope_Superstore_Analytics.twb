      <column aggregation='None' caption='Total CY Sales (bin)' datatype='integer' name='[Total CY Sales (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='3' formula='[Calculation_756886264846561280]' peg='0' size='4000' />
      </column>
      <column caption='Total CY Profit' datatype='real' name='[Total CY Sales (copy)_756886264851349507]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Order Date])= {MAX(year([Order Date]))} THEN [Profit] END' />
      </column>
      <column caption='Total CY Quantity' datatype='integer' name='[Total CY Sales (copy)_772930338649939969]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Order Date])= {MAX(year([Order Date]))} THEN [Quantity] END' />
      </column>
      <column caption='Total PY Profit' datatype='real' name='[Total PY sales (copy)_756886264851464196]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Order Date])={MAX(YEAR([Order Date]))}-1&#13;&#10;&#13;&#10; THEN [Profit] END' />
      </column>
      <column caption='Total PY Quantity' datatype='integer' name='[Total PY sales (copy)_772930338650066946]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Order Date])={MAX(YEAR([Order Date]))}-1&#13;&#10;&#13;&#10; THEN [Quantity] END' />
      </column>
      <column caption='YOY quantity Symbol' datatype='string' name='[YOY Profit Symbol (copy)_1402589862224494596]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [YOY Sales (copy)_1402589862135033857]&gt;0 THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
      </column>
      <column caption='YOY Profit' datatype='real' name='[YOY Sales (copy)_1402589862134738944]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Total CY Sales (copy)_756886264851349507])-SUM([Total PY sales (copy)_756886264851464196]))/SUM([Total PY sales (copy)_756886264851464196])' />
      </column>
      <column caption='YOY Quantity' datatype='real' name='[YOY Sales (copy)_1402589862135033857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Total CY Sales (copy)_772930338649939969])-SUM([Total PY sales (copy)_772930338650066946]))/SUM([Total PY sales (copy)_772930338650066946])' />
      </column>
      <column caption='YOY Profit Symbol' datatype='string' name='[YOY Sales Symbol (copy)_1402589862224400387]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [YOY Sales (copy)_1402589862134738944]&gt;0 THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
      </column>
      <column caption='Orders' datatype='table' name='[__tableau_internal_object_id__].[Orders_ECFCA1FB690A41FE803BC071773BA862]' role='measure' type='quantitative' />
      <column caption='min max cy profit' datatype='real' name='[min max cy sales (copy)_756886264851714053]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Total CY Sales (copy)_756886264851349507]) = WINDOW_MAX(SUM([Total CY Sales (copy)_756886264851349507])) &#13;&#10;THEN SUM([Total CY Sales (copy)_756886264851349507])&#13;&#10;ELSEIF SUM([Total CY Sales (copy)_756886264851349507]) = WINDOW_MIN(SUM([Total CY Sales (copy)_756886264851349507])) &#13;&#10;THEN SUM([Total CY Sales (copy)_756886264851349507])&#13;&#10;ELSE NULL END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='min max cy quantity' datatype='integer' name='[min max cy sales (copy)_772930338650238979]' role='measure' type='quantitative'>

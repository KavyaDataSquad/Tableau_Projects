      <aliases enabled='yes' />
      <column caption='Average DTI' datatype='real' name='[Average Interest Rate (copy)_1178817250933669901]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([dti])' />
      </column>
      <column caption='Bad loan Recevied Amount ' datatype='integer' name='[Bad loan Funded Amount (copy)_128634117267918848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF([loan_status] =&apos;Charged Off&apos;)&#13;&#10;then&#13;&#10;[total_payment]&#13;&#10;END)' />
      </column>
      <column caption='MoM Loan Applications' datatype='real' name='[Calculation_1103381957924085769]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1178817250872025089]-[MTD Loan Application (copy)_1178817250897018882])/[MTD Loan Application (copy)_1178817250897018882]' />
      </column>
      <column caption='MoM Average INT' datatype='real' name='[Calculation_1103381957936877581]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([MTD Received Amount (copy)_1178817250932133898]-[MTD Average Interest Rate (copy)_1103381957936713740])/[MTD Average Interest Rate (copy)_1103381957936713740]' />
      </column>
      <column caption='Total Loan Applications' datatype='integer' name='[Calculation_1178817250869227520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([id])' />
      </column>
      <column caption='MTD Loan Application' datatype='integer' name='[Calculation_1178817250872025089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF &#13;&#10;DATEDIFF(&apos;month&apos;,[issue_date],{MAX([issue_date])})= 0&#13;&#10;THEN[id]&#13;&#10;END)' />
      </column>
      <column caption='Average Interest Rate' datatype='real' name='[Calculation_1178817250931101705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([int_rate])' />
      </column>
      <column caption='Good loan Application' datatype='integer' name='[Calculation_1178817250935767055]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF([loan_status] =&apos;Fully Paid&apos; or [loan_status] = &apos;Current&apos;)&#13;&#10;then&#13;&#10;[id]&#13;&#10;END)' />
      </column>
      <column caption='Dynamic Measure' datatype='integer' name='[Calculation_446137897162797056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2]= &apos;Total Loan Applications&apos; THEN [Calculation_1178817250869227520]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Total Funded Amount&apos; THEN [Total Loan Applications (copy)_1178817250898083843]&#13;&#10;ELSEIF [Parameters].[Parameter 2]= &apos;Total_Received_Amount&apos; THEN [Total Funded Amount (copy)_1178817250928914438]&#13;&#10;END' />
      </column>
      <column caption='Good loan Funded amount' datatype='integer' name='[Good loan Application (copy)_1103381957900677120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF([loan_status] =&apos;Fully Paid&apos; or [loan_status] = &apos;Current&apos;)&#13;&#10;then&#13;&#10;[loan_amount]&#13;&#10;END)' />
      </column>
      <column caption='Good loan Percentage' datatype='real' name='[Good loan Application (copy)_1103381957902671874]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF([loan_status] =&apos;Fully Paid&apos; or [loan_status] = &apos;Current&apos;)&#13;&#10;then&#13;&#10;[id]&#13;&#10;END)/COUNT([id])' />
      </column>
      <column caption='Bad Loan Application' datatype='integer' name='[Good loan Application (copy)_1103381957903319043]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF([loan_status])= &apos;Charged Off&apos; THEN&#13;&#10;[id]&#13;&#10;END)' />
      </column>
      <column caption='Good loan Received amount ' datatype='integer' name='[Good loan Funded amount (copy)_1103381957902102529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF([loan_status] =&apos;Fully Paid&apos; or [loan_status] = &apos;Current&apos;)&#13;&#10;then&#13;&#10;[total_payment]&#13;&#10;END)' />
      </column>
      <column caption='Bad loan Funded Amount' datatype='integer' name='[Good loan Funded amount (copy)_1103381957905514501]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF([loan_status] =&apos;Charged Off&apos;)&#13;&#10;then&#13;&#10;[loan_amount]&#13;&#10;END)' />
      </column>
      <column caption='Bad loan Percentage ' datatype='real' name='[Good loan Percentage (copy)_1103381957904252932]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF([loan_status])=&apos;Charged Off&apos; then&#13;&#10;[id]&#13;&#10;END)/COUNT([id])' />
      </column>
      <column caption='Good v/s Bad Loan (copy)' datatype='string' name='[Good v/s Bad Loan (copy)_414612690983653376]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[loan_status]' new-bin='true'>
          <bin default-name='false' value='&quot;Bad Loan&quot;'>

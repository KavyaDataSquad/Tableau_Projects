        </calculation>
      </column>
      <column caption='PMTD Average Interest Rate' datatype='real' name='[MTD Average Interest Rate (copy)_1103381957936713740]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF &#13;&#10;DATEDIFF(&apos;month&apos;,[issue_date],{MAX([issue_date])})= 1&#13;&#10;THEN [int_rate]&#13;&#10;END)' />

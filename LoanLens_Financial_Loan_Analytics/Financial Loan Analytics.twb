          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='financial_loan' name='federated.1fspyx60za0spv1bvc3qw0eojgrr' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Measure' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total Loan Applications&quot;'>
              <calculation class='tableau' formula='&quot;Total Loan Applications&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1fspyx60za0spv1bvc3qw0eojgrr'>
            <column caption='Total Loan Applications' datatype='integer' name='[Calculation_1178817250869227520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([id])' />
            </column>
            <column caption='Dynamic Measure' datatype='integer' name='[Calculation_446137897162797056]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]= &apos;Total Loan Applications&apos; THEN [Calculation_1178817250869227520]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Total Funded Amount&apos; THEN [Total Loan Applications (copy)_1178817250898083843]&#13;&#10;ELSEIF [Parameters].[Parameter 2]= &apos;Total_Received_Amount&apos; THEN [Total Funded Amount (copy)_1178817250928914438]&#13;&#10;END' />
            </column>
            <column caption='Total_Received_Amount' datatype='integer' name='[Total Funded Amount (copy)_1178817250928914438]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum([total_payment])' />
            </column>
            <column caption='Total Funded Amount' datatype='integer' name='[Total Loan Applications (copy)_1178817250898083843]' role='measure' type='quantitative'>
